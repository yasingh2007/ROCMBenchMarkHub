# Auth.js — required in production
AUTH_SECRET=generate-a-long-random-string

# GitHub OAuth (optional locally; Dev Login works without these)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Neon Postgres (optional locally; PGlite is used when unset)
DATABASE_URL=

# Local PGlite directory (optional; `next dev` defaults to .data/pglite)
ROCM_DB_PATH=.data/pglite

# Use in-memory PGlite instead of disk (CI / tests)
# ROCM_DB_MEMORY=1

# Cloudflare R2 artifact uploads (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Screenshot script (optional)
# CAPTURE_URL=http://localhost:3000
# PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers