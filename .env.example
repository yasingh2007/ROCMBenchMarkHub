# Auth.js — required in production
AUTH_SECRET=generate-a-long-random-string

# GitHub OAuth (optional locally; Dev Login works without these)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Neon Postgres (optional locally; PGlite under .data/ is used when unset)
DATABASE_URL=

# Cloudflare R2 artifact uploads (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
